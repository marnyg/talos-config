#!/usr/bin/env sh
# pre-push: refuse to push a stale Go vendorHash, or a Go package whose
# other-OS half no longer type-checks (see the second block).
#
# config-server-bin, iroh-transport and actors-bin vendor the local
# `replace`d modules (protocol/, iroh-transport/, iroh-go/iroh/) into a
# fixed-output derivation, so any change under those trees — or to a
# go.mod/go.sum of those modules (not any nested spike module: deleting
# iroh-go/mobile/go.mod cost a full no-op dance, 2026-10-17) — changes
# the hash while a cached vendor dir keeps
# building fine locally. CI's `vendor-hash` job catches it, but we push
# straight to main and nobody reads a red Actions tab: on 2026-09-20
# main sat red for 14 pushes until darwin-rebuild hit the stale cache
# (irohup built against an iroh-transport without Conn.Paths).
#
# So: when the pushed range touches one of those inputs, realise the
# FODs that input feeds and re-run each with --rebuild (the two-step
# dance documented on config-server/nix/default.nix; --rebuild
# re-fetches the modules, so ~1 min per attr). Only the attrs an input
# can move are checked: the three vendored trees feed config-server-bin,
# iroh-transport and actors-bin; a module's own go.mod/go.sum and
# nix/default.nix feed that module's attr alone. actors/ and
# config-server/ sources are consumers, never vendored — a .go change
# there moves no hash (2026-10-19: every actors push paid 4 attrs × 2
# builds, ~5 min, for a hash that could not have changed). The
# flake is evaluated at the pushed commit (git+file://…?rev=), not the
# working tree: `$repo#attr` folds uncommitted edits under a replace'd
# module into the vendor dir and fails pushes that do not carry them.
# Set SKIP_VENDOR_HASH=1 to bypass. Delegates to beads' shim afterwards.

set -eu
repo=$(git rev-parse --show-toplevel)
# git hands the pushed refs over stdin, once. Every block below (and
# beads' shim) reads them, so keep a copy: a bare `while read` in the
# first block used to drain it and the cross-OS check never saw a ref.
refs=$(cat)

if [ "${SKIP_VENDOR_HASH:-0}" != "1" ]; then
  touched=""
  attrs=""  # the goModules attrs the touched inputs feed, space-separated
  pushed="" # "<local_ref> <local_sha>" per ref whose range touches an input
  # attrs_for prints the attrs one changed path can move.
  attrs_for() {
    case "$1" in
      protocol/*|iroh-transport/*|iroh-go/*) echo "config-server-bin iroh-transport actors-bin" ;;
      config-server/*) echo "config-server-bin" ;;
      actors/*)        echo "actors-bin" ;;
      workouts/*)      echo "workouts-bin" ;;
    esac
  }
  while read -r local_ref local_sha _remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue                                           # no refs (the heredoc's blank line)
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue # deleting a ref
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      range="$local_sha --not --remotes"
    else
      range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    files=$(git -C "$repo" diff --name-only $range -- \
      'protocol/**/*.go' 'protocol/*.go' 'iroh-transport/**/*.go' 'iroh-transport/*.go' 'iroh-go/iroh' \
      'config-server/go.*' 'protocol/go.*' 'iroh-transport/go.*' 'iroh-go/go.*' 'actors/go.*' 'workouts/go.*' \
      'config-server/nix/default.nix' 'iroh-transport/nix/default.nix' 'actors/nix/default.nix' 'workouts/nix/default.nix' 2>/dev/null || true)
    [ -n "$files" ] && touched="$touched$files
" && pushed="$pushed$local_ref $local_sha
"
    for f in $files; do attrs="$attrs $(attrs_for "$f")"; done
  done <<EOF
$refs
EOF

  if [ -n "$touched" ]; then
    # shellcheck disable=SC2086
    attrs=$(printf '%s\n' $attrs | sort -u | tr '\n' ' ')
    echo "pre-push: vendored inputs changed in the pushed range (checking:$attrs):" >&2
    printf '%s' "$touched" | sort -u | sed 's/^/  /' >&2
    log=$(mktemp "${TMPDIR:-/tmp}/pre-push-vendor.XXXXXX")
    trap 'rm -f "$log"' EXIT
    printf '%s' "$pushed" | sort -u | while read -r local_ref local_sha; do
      [ -z "$local_sha" ] && continue
      flake="git+file://$repo?ref=$local_ref&rev=$local_sha"
      for attr in $attrs; do
        echo "pre-push: checking .#$attr.goModules vendorHash at ${local_sha%"${local_sha#???????}"}…" >&2
        # Realise first (substitution allowed — a stale cached output is
        # exactly the case), then --rebuild (implies --check) compares.
        for flags in "" "--rebuild"; do
          # shellcheck disable=SC2086
          if ! nix build "$flake#$attr.goModules" --no-link $flags >"$log" 2>&1; then
            grep -E "specified:|got:|error:" "$log" >&2 || cat "$log" >&2
            echo "pre-push: .#$attr vendorHash is stale at $local_sha — paste the 'got:' hash into its nix/default.nix, commit, push again (SKIP_VENDOR_HASH=1 to override)" >&2
            exit 1
          fi
        done
      done
    done || exit 1
    echo "pre-push: vendorHashes OK" >&2
  fi
fi

# Cross-OS type check (scripts/oscheck.go). Packages split by OS build
# constraint only get the host's half compiled locally; the linux half
# of cmd/irohup rotted for a day after c075081 and the hub image build
# (the fly deploy) was what noticed. CI's hub-image job goes red too,
# but same story as above: nobody reads the tab. ~50 s when Go under
# config-server/ (or the modules it replaces) is in the pushed range.
# SKIP_OSCHECK=1 to bypass.
if [ "${SKIP_OSCHECK:-0}" != "1" ]; then
  gotouched=""
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      range="$local_sha --not --remotes"
    else
      range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    files=$(git -C "$repo" diff --name-only $range -- \
      'config-server/**/*.go' 'config-server/*.go' 'protocol/**/*.go' 'protocol/*.go' \
      'iroh-transport/**/*.go' 'iroh-transport/*.go' 'iroh-go/iroh' 2>/dev/null || true)
    [ -n "$files" ] && gotouched="$gotouched$files
"
  done <<EOF
$refs
EOF
  if [ -n "$gotouched" ]; then
    case "$(uname -s)" in
      Darwin) other=linux ;;
      *) other=darwin ;;
    esac
    # Packages with an OS build constraint anywhere in them.
    pkgs=$(cd "$repo/config-server" && grep -rlE '^//go:build.*(darwin|linux|android|windows|unix)' --include='*.go' . | xargs -n1 dirname | sort -u)
    if [ -n "$pkgs" ]; then
      echo "pre-push: type-checking OS-split packages for GOOS=$other:" >&2
      printf '%s\n' "$pkgs" | sed 's/^/  /' >&2
      # shellcheck disable=SC2086
      if ! (cd "$repo/config-server" && go run ../scripts/oscheck.go "$other" $pkgs >&2); then
        echo "pre-push: GOOS=$other type check failed (SKIP_OSCHECK=1 to override)" >&2
        exit 1
      fi
    fi
  fi
fi

# Signed tip (talos-config-lehx). The hub will serve talos/ from the
# git tip rather than an image snapshot (k9h7), accepting only a tip
# whose SSHSIG verifies against talos/allowed-signers — GitHub is not
# a root of trust (invariant 3). An unsigned tip on main would be a
# tree the hub refuses, silently, until someone reads /status. The
# tip's signature attests the whole tree, so only the tip is checked.
# Setup per clone: gpg.format ssh, user.signingkey ~/.ssh/id_ed25519.pub,
# commit.gpgsign true (AGENTS.md). SKIP_SIGNED=1 to bypass.
if [ "${SKIP_SIGNED:-0}" != "1" ]; then
  while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if ! git -C "$repo" -c gpg.ssh.allowedSignersFile="$repo/talos/allowed-signers" \
        verify-commit "$local_sha" >/dev/null 2>&1; then
      echo "pre-push: tip of $local_ref (${local_sha%"${local_sha#???????}"}) is not signed by a key in talos/allowed-signers" >&2
      echo "pre-push: git config gpg.format ssh && git config user.signingkey ~/.ssh/id_ed25519.pub && git config commit.gpgsign true; then git commit --amend --no-edit -S (SKIP_SIGNED=1 to override)" >&2
      exit 1
    fi
  done <<EOF
$refs
EOF
fi

# beads' shim (core.hooksPath used to point at .beads/hooks directly).
if [ -x "$repo/.beads/hooks/pre-push" ]; then
  exec "$repo/.beads/hooks/pre-push" "$@" <<EOF
$refs
EOF
fi
