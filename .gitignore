.direnv/

# Decrypted secrets — tracked as .age files
talos/talosconfig
# Cluster admin credentials, generated by `talosctl kubeconfig` — a bearer
# credential for the whole cluster, and nothing recreates it from git, so
# it must never be committed by accident.
kubeconfig
# Suffix match, so a new secret file is ignored by default rather than
# by remembering to add a line here (matches the encrypt-secrets glob).
talos/clusters/**/*secrets.yaml
result
config-server/config-server
.claude/
k8s/MIGRATION.md

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
