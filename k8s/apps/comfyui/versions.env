# The ONE place the ComfyUI stack is pinned — sourced by setup-local.sh
# (desktop venv) and the cluster image build, so every GPU in the
# benchmark runs the same code (epic talos-config-e6rx).
COMFYUI_REPO=https://github.com/comfyanonymous/ComfyUI
COMFYUI_REF=v0.45.5
PYTHON=3.13
TORCH_BACKEND=cu130
