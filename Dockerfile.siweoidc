# SIWE→OIDC bridge (config-server/cmd/siweoidc), deployed in-cluster —
# built and pushed to ghcr by .github/workflows/siwe-oidc-image.yml.
# Static binary, FROM scratch: the service holds no secrets, reads no
# files, and dials nothing out (per-boot key, in-memory state), so the
# image is the binary and nothing else. Toolchain tag follows go.mod —
# bump together with the root Dockerfile and flake.nix (see the note
# there).
#
# Layout mirrors the repo because config-server/go.mod replaces its
# sibling modules by relative path (../protocol, ../iroh-transport,
# ../iroh-go). The bridge compiles protocol/cert (via policy, for the
# group vocabulary); the iroh modules are only needed as go.mod files
# so the module graph loads — nothing from them is built, and the
# binary stays CGO-free. The .dockerignore allowlist keeps the context
# to exactly these paths.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY protocol/ protocol/
COPY iroh-transport/go.mod iroh-transport/go.sum iroh-transport/
COPY iroh-go/go.mod iroh-go/
COPY config-server/ config-server/
WORKDIR /src/config-server
RUN CGO_ENABLED=0 go build -trimpath -o /out/siweoidc ./cmd/siweoidc

FROM scratch
COPY --from=build /out/siweoidc /siweoidc
USER 65534:65534
ENTRYPOINT ["/siweoidc"]
