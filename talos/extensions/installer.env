# The fleet installer's ingredients — the ONE place the Talos version and
# the official system extensions are spelled out. build.sh sources this;
# talos/hardware/*.yaml pin the image it produces (tag + digest) and point
# here rather than repeating the list. Bump Talos or an extension here,
# rebuild, repin both hardware files.
#
# Refs: https://factory.talos.dev/version/$TALOS/extensions/official
# (these three are what factory schematic 6a9acc… carried before the
# imager build replaced it, ADR-0023).
TALOS=v1.12.6
OFFICIAL=(
  ghcr.io/siderolabs/iscsi-tools:v0.2.0
  ghcr.io/siderolabs/nebula:1.10.3
  ghcr.io/siderolabs/util-linux-tools:2.41.2
)
